          "text": "# panelValue - the PanelValue object that changed\n# Make sure the corresponding toggle is enabled in the Panel Execute DAT.\n\ndef onValueChange(panelValue):\n    parent().par.value0 = panelValue\n    print('[TD Bridge DEBUG] Launch button state changed:', panelValue)\n    modal = op('/project1/MyUI/ModalDialog')\n    # panelValue is 1 when pressed (momentary), 0 when released\n    if panelValue:\n        modal.par.display = True\n        print('[TD Bridge DEBUG] Modal opened!')\n    else:\n        pass  # don't close on release\n    return\n",
